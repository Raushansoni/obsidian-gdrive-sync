# Optional — npm run setup auto-detects vaults from Obsidian if unset
OBSIDIAN_VAULT_PATH=C:\Users\YOU\Documents\MyVault

# Baked into main.js at build time (never commit .env). Enables Connect Google on mobile without pasting.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:42813/
